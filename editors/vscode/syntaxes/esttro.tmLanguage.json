{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "esttro",
  "scopeName": "source.esttro",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#function-declaration"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.esttro",
          "match": "//.*$"
        },
        {
          "name": "comment.line.double-dash.esttro",
          "match": "--.*$"
        },
        {
          "name": "comment.block.esttro",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.esttro",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.esttro",
          "match": "\\\\([nrt\\\\\"0{}]|x[0-9a-fA-F]{2})"
        },
        {
          "name": "meta.interpolation.esttro",
          "begin": "(?<!\\\\)\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.esttro"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.esttro"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "function-declaration": {
      "match": "\\b(function|fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.function.esttro"
        },
        "2": {
          "name": "entity.name.function.declaration.esttro"
        }
      }
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.esttro",
          "match": "\\b(print|assert|toInt|toFloat|toDouble|toString|toBoolean)\\b"
        }
      ]
    },
    "function-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.esttro"
        }
      }
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.esttro",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.esttro",
          "match": "\\b(if|else|while|for|return|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.esttro",
          "match": "\\b(let|const|function|fn)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.esttro",
          "match": "\\b(int|float|double|boolean|string|void)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.esttro",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?[fF]\\b"
        },
        {
          "name": "constant.numeric.double.esttro",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.esttro",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.esttro",
          "match": "->"
        },
        {
          "name": "keyword.operator.range.esttro",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.esttro",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.esttro",
          "match": "\\+=|-=|\\*=|/=|%=|="
        },
        {
          "name": "keyword.operator.logical.esttro",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.esttro",
          "match": "[+\\-*/%]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.esttro",
          "match": "[,:;]"
        },
        {
          "name": "punctuation.bracket.esttro",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}

